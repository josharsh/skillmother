{
  "name": "skillmother",
  "version": "0.2.0",
  "description": "The CI/CD pipeline for AI coding skills. Lint, test, and govern SKILL.md files for your team.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "skillmother": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:self": "node dist/cli.js lint",
    "test:self": "node dist/cli.js test",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "claude-code",
    "skills",
    "agent-skills",
    "SKILL.md",
    "linter",
    "testing",
    "governance",
    "cli",
    "ai-coding",
    "skill-management"
  ],
  "author": "Harsh Joshi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josharsh/skillmother.git"
  },
  "homepage": "https://github.com/josharsh/skillmother#readme",
  "bugs": {
    "url": "https://github.com/josharsh/skillmother/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
